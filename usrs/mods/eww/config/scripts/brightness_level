#!/usr/bin/env bash

# print current backlight brightness as an integer 0-100 (0 if unavailable)
BRIGHTNESSCTL="${BRIGHTNESSCTL:-$(command -v brightnessctl)}"
if [ -z "$BRIGHTNESSCTL" ]; then
  echo 0
  exit 0
fi
LEVEL=$("$BRIGHTNESSCTL" -m 2>/dev/null | awk -F, '{print $4}' | tr -d '%\n')
echo "${LEVEL:-0}"
