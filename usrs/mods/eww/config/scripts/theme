#!/usr/bin/env bash
# Toggle dark/light.
#   - colors: activate the matching Home Manager specialisation.
#   - wallpaper: flip the stable symlink that the swaybg service reads.
# The wallpaper symlink is the single source of truth for the current mode.
#
# The active generation is read from /etc/current-home-generation (written by
# the system module): NixOS-managed Home Manager has no user profile symlink,
# and baking the generation path into this file would recurse.
set -euo pipefail

SYSTEMCTL="${SYSTEMCTL:-$(command -v systemctl)}"
PKILL="${PKILL:-$(command -v pkill)}"
SD_BUS="${SD_BUS:-$(command -v busctl)}"
SDBUS2="${SDBUS2:-$(command -v dbus-send)}"

GEN="$(readlink -f /etc/current-home-generation)"
WALL_LINK="$HOME/.config/niri/wallpaper.png"
DARK="$HOME/.config/eww/images/wallpapers/stitch_wall_dark.png"
LIGHT="$HOME/.config/eww/images/wallpapers/stitch_wall.png"

mkdir -p "$(dirname "$WALL_LINK")"

if [[ "$(readlink -f "$WALL_LINK" 2>/dev/null)" == "$(readlink -f "$LIGHT")" ]]; then
  target="$DARK"
  spec="dark"
else
  target="$LIGHT"
  spec="light"
fi
ln -sfn "$target" "$WALL_LINK"

if [[ "$spec" == "light" ]]; then
  "$GEN/specialisation/light/activate"
else
  "$GEN/activate"
fi

"$SYSTEMCTL" --user restart swaybg.service

# `eww reload` re-reads yuck but does NOT recompile the stylesheet, so the bar
# would keep the old palette. Restart the daemon so it recompiles theme.scss.
# Detached via systemd-run because this script runs as a child of eww.service:
# restarting the service in-line would kill the script (and its systemctl call)
# partway through.
systemd-run --user --collect --quiet "$SYSTEMCTL" --user restart eww.service
