# Toggle between the default (dark) Stylix scheme and the "light"
# home-manager specialisation defined in usrs/default.nix. Both generations
# are already built by the last `nixos-rebuild switch` - toggling just runs
# the matching generation's activation script (relinks dotfiles, including
# eww's generated theme.scss) and asks eww to reload. No rebuild involved.

STATE_FILE="$HOME/.cache/eww-theme-state"
PROFILE_DIR="$HOME/.local/state/nix/profiles/home-manager"

CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "dark")

if [[ "$CURRENT" == "dark" ]]; then
  NEW="light"
  ACTIVATE="$PROFILE_DIR/specialisation/light/activate"
else
  NEW="dark"
  ACTIVATE="$PROFILE_DIR/activate"
fi

"$ACTIVATE"
echo "$NEW" >"$STATE_FILE"

eww reload
eww update theme="$NEW"
