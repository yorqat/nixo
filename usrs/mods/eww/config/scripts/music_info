#!/usr/bin/env bash
# Music metadata for eww, event-driven via `mpc idle` (was: 2 Hz polling that
# spawned ~6 `mpc` calls per tick, forever). JSON is built with jq so titles with
# quotes/newlines can't corrupt it.

COVER="/tmp/eww_mp_thumbnail.png"
MUSIC_DIR="$HOME/Music"
FFMPEG="${FFMPEG:-$(command -v ffmpeg)}"
MPC="${MPC:-$(command -v mpc)}"
JQ="${JQ:-$(command -v jq)}"

cur_file() { "$MPC" current -f '%file%' 2>/dev/null; }

# Block on mpd idle; when mpd is down `mpc idle` returns instantly with an
# error, so back off instead of busy-looping at 100% CPU until it comes back.
mpd_idle() {
  if ! "$MPC" idle player >/dev/null 2>&1; then
    sleep 5
  fi
}

get_cover() {
  local f
  f="$(cur_file)"
  if [[ -n "$f" && -f "$MUSIC_DIR/$f" ]] &&
    if "$FFMPEG" -i "$MUSIC_DIR/$f" -map 0:v:0 -c copy "$COVER" -y >/dev/null 2>&1; then
    echo "$COVER"
  else
    echo "images/icons/music.jpg"
  fi
}

emit_meta() {
  jq -cn \
    --arg title "$("$MPC" current -f '%title%' 2>/dev/null)" \
    --arg artist "$("$MPC" current -f '%artist%' 2>/dev/null)" \
    --arg cover "$(get_cover)" \
    '{ title: $title, artist: $artist, cover: $cover }'
}

emit_state() {
  local status playing repeat random percentile
  status="$("$MPC" status 2>/dev/null)"
  playing=false
  repeat=false
  random=false
  grep -q "\[playing\]" <<<"$status" && playing=true
  grep -q "repeat: on" <<<"$status" && repeat=true
  grep -q "random: on" <<<"$status" && random=true
  percentile="$("$MPC" status '%percenttime%' 2>/dev/null | tr -cd '0-9')"
  jq -cn \
    --arg time "$("$MPC" status '%currenttime% - %totaltime%' 2>/dev/null)" \
    --argjson playing "$playing" \
    --argjson repeat "$repeat" \
    --argjson random "$random" \
    --argjson percentile "${percentile:-0}" \
    '{ time: $time, playing: $playing, repeat: $repeat, random: $random, percentile: $percentile }'
}

# Track metadata: only re-emit when the playing file changes; block on idle
# between changes (zero cost while paused/stopped).
listen_meta() {
  local last="__init__" f
  while true; do
    f="$(cur_file)"
    if [[ "$f" != "$last" ]]; then
      last="$f"
      emit_meta
    fi
    mpd_idle
  done
}

# Playback state: progress only advances while playing, so poll 1s then; when
# paused/stopped, block on idle instead of spinning.
listen_playing_meta() {
  while true; do
    emit_state
    if "$MPC" status 2>/dev/null | grep -q "\[playing\]"; then
      sleep 1
    else
      mpd_idle
    fi
  done
}

case "${1:-}" in
  --listen_meta) listen_meta ;;
  --listen_playing_meta) listen_playing_meta ;;
  *) exit 1 ;;
esac
