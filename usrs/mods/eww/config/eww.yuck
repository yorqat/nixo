;; music player widget
(include "music.yuck")

;; notifications widget
(include "notifs.yuck")

;; volume/brightness OSD + powermenu
(include "osc.yuck")

;; every workspace niri has, pre-resolved to icons/classes/niri commands (see
;; scripts/workspaces); the bar renders whatever is in the list instead of a
;; fixed set, so unnamed workspaces show up and stay clickable too
(deflisten ws_list :initial "[]" "scripts/workspaces")

;; theme reflects the wallpaper symlink; the in-band toggle restarts eww, so
;; this poll only covers out-of-band changes (terminal toggle, reboot reset)
(defpoll theme_mode :interval "1m" "scripts/theme_mode")

;; main bar
(defwindow bar
  :monitor 0
  :exclusive true
  :stacking "fg"
  :geometry (geometry
    :x "0%"
    :y "0%"
    :height "36px"
    :width "100%"
    :anchor "top center")
  (centerbox :orientation "h" :class "bar"
    (box :orientation "h" :spacing 8 (start_menu) (workspaces) (win_controls))
    (time)
    (system)))

;; one button per workspace, straight from scripts/workspaces: click to focus,
;; right-click sends the focused window without following, middle sends and
;; follows. Class/tooltip/commands all come from the JSON, nothing hardcoded.
(defwidget workspaces []
  (eventbox :onscroll "scripts/switch_workspace --{}"
    (box :class "workspaces" :orientation "h" :halign "start" :spacing 0
      (for w in ws_list
        (button :class {w.class}
                :tooltip {w.tip}
                :onclick {w.focus}
                :onrightclick {w.send}
                :onmiddleclick {w.move}
          {w.icon})))))

;; window/column rearranging + layout, driven straight from niri actions
(defwidget win_controls []
  (box :class "win-controls" :orientation "h" :halign "start" :spacing 0
    (button :class "win-btn" :tooltip "Move column left (Mod+Ctrl+H)" :onclick "niri msg action move-column-left" "󰅁")
    (button :class "win-btn" :tooltip "Move column right (Mod+Ctrl+L)" :onclick "niri msg action move-column-right" "󰅂")
    (button :class "win-btn" :tooltip "Move window up (Mod+Ctrl+K)" :onclick "niri msg action move-window-up" "󰅃")
    (button :class "win-btn" :tooltip "Move window down (Mod+Ctrl+J)" :onclick "niri msg action move-window-down" "󰅄")
    (button :class "win-btn" :tooltip "Toggle tabs in column (Mod+W)" :onclick "niri msg action toggle-column-tabbed-display" "󰓩")))

(defpoll clock :interval "1s" "date +\%H:%M:%S")
(defpoll date :interval "30m" "date +\%D")

(defwidget start_menu []
  (box :orientation "h" :class "start-menu" :width 100  :halign "start"
    (button :width 32 :height 32 :class "start-icon" 
      (image :path "images/icons/nixos--sandy.png" :image-width 24 :image-height 24)
    )
  )
)

(defwidget time []
  (button :class "time hovered-prim"
    :tooltip date
    (label :text clock)))

(defwidget system []
  (box :orientation "h" :class "system padded"  :halign "end"
    (box 
      :orientation "h"
      :spacing 16
      (systray :class "systray" :orientation "h" :spacing 8 :icon-size 20)
      (button :class "theme-toggle" :timeout "2000ms" :tooltip {theme_mode == "light" ? "Swap Theme → dark" : "Swap Theme → light"} :onclick "scripts/theme" {theme_mode == "light" ? "" : ""})
      (button :class "" :tooltip "Reboot" :onclick "systemctl reboot" "")
      (button :class "" :tooltip "Shut Down" :onclick "systemctl poweroff" '󰤆')
    )
  )
)
