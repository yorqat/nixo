{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "nix-original.png",
    "width": 22,
    "height": 22,
    "padding": { "right": 7 }
  },
  "display": {
    "separator": "    ",
    "percent": { "type": 1 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[35m────────────────────────────" },
    { "type": "cpu", "key": "󰻠", "format": "{name}" },
    { "type": "memory", "key": "" },
    { "type": "gpu", "key": "" },
    { "type": "custom", "format": "\u001b[35m────────────────────────────" },
    { "type": "kernel", "key": "󰞸" },
    { "type": "packages", "key": "󰏖" },
    { "type": "de", "key": "󰧨" }
  ]
}
